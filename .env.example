# ------------------------------------------------------------------
# OpenJar environment config
# Copy to .env and fill in what you need. Nothing here is required to
# boot the app locally except DATABASE_URL + BETTER_AUTH_SECRET.
# ------------------------------------------------------------------

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/openjar?schema=public"

# App
BASE_URL="http://localhost:3000"

# Auth
# generate one: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me-with-a-long-random-secret"
# "origin" | "baseURL" | "disabled" — how auth validates the request origin
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3000"

# OAuth — optional, signup works with email/password without these
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub data (repos, stars, contributions). Public repos work without a
# token but the API is rate limited — add one for real usage.
GITHUB_TOKEN=""

# Email (Resend)
RESEND_API_KEY=""
EMAIL_FROM="OpenJar <no-reply@openjar.dev>"

# Storage — local during dev, S3-compatible in prod
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# Payments — provider abstraction. Choose the active provider:
#   stripe | lemonsqueezy | manual
PAYMENT_PROVIDER="manual"

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Lemon Squeezy
LEMONSQUEEZY_API_KEY=""
LEMONSQUEEZY_STORE_ID=""
LEMONSQUEEZY_WEBHOOK_SECRET=""
# variant id for one-time (pay-what-you-want) checkouts and for memberships
LEMONSQUEEZY_DEFAULT_VARIANT=""
LEMONSQUEEZY_MEMBERSHIP_VARIANT=""

# Admin bootstrap — on first seed, this username becomes an admin
ADMIN_USERNAME=""
